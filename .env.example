# Copy to .env.local and fill with TEST keys (dashboard → test mode).
# Live keys only via host env in production. Never commit .env.local.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Amount in smallest unit. INR 249900 (₹2,499 ≈ $29) shows UPI + cards.
# USD orders show international cards only (UPI is INR-only).
RAZORPAY_CURRENCY=INR
RAZORPAY_AMOUNT=249900
DATABASE_URL=
# Live audit providers (Ticket 6). Both server-side only, never shipped to client.
# Missing keys = canned fixture mode (honest demo, no fabricated scores sold).
GEMINI_API_KEY=
FIRECRAWL_API_KEY=
# Bearer guard for /api/cron/refresh (Vercel Cron). Generate: openssl rand -hex 32
CRON_SECRET=
